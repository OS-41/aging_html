# aging APIのAPIキー(必須)。このファイルをコピーして .env を作成し、値を設定する。
# Codespacesでは .env の代わりに Codespaces secrets に登録してもよい。
AGING_API_KEY=

# ---- 以下はRenderなどで公開するときだけ設定する(未設定なら無効) ----

# このサーバーの公開URL。設定するとaging APIに渡す画像URLの組み立てに
# クライアント申告のoriginではなくこの値を使う。
# 例: PUBLIC_ORIGIN=https://aging-demo.onrender.com
PUBLIC_ORIGIN=

# Basic認証。両方設定するとフロントとAPIが認証必須になる。
# (画像取得用の GET /files/:file_id だけは外部のaging APIが取得するため対象外)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# 推測困難な公開パス。設定するとアプリ全体がこのパス配下でのみ動く。
# 例: APP_BASE_PATH=/k7f3m2q8
APP_BASE_PATH=
